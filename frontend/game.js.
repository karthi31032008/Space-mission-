
import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';

// SCENE
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x02030b);
scene.fog = new THREE.FogExp2(0x02030b, 0.012);

// CAMERA
const camera = new THREE.PerspectiveCamera(
    75,
    window.innerWidth / window.innerHeight,
    0.1,
    1000
);
camera.position.set(0, 5, 12);

// RENDERER
const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
document.getElementById('game-container').appendChild(renderer.domElement);

// LIGHTS
const ambient = new THREE.AmbientLight(0xffffff, 1.5);
scene.add(ambient);

const sunlight = new THREE.DirectionalLight(0x88bbff, 2);
sunlight.position.set(5, 10, 5);
scene.add(sunlight);

// FLOOR
const floorGeometry = new THREE.PlaneGeometry(200, 200);
const floorMaterial = new THREE.MeshStandardMaterial({
    color: 0x10152b,
    roughness: 0.9
});

const floor = new THREE.Mesh(floorGeometry, floorMaterial);
floor.rotation.x = -Math.PI / 2;
floor.position.y = -1;
scene.add(floor);

// STARS
const starGeometry = new THREE.BufferGeometry();
const starPositions = [];

for (let i = 0; i < 1500; i++) {
    starPositions.push(
        (Math.random() - 0.5) * 300,
        Math.random() * 150,
        (Math.random() - 0.5) * 300
    );
}

starGeometry.setAttribute(
    'position',
    new THREE.Float32BufferAttribute(starPositions, 3)
);

const stars = new THREE.Points(
    starGeometry,
    new THREE.PointsMaterial({
        color: 0xffffff,
        size: 0.5
    })
);
scene.add(stars);

// PLAYER
const player = new THREE.Group();

const body = new THREE.Mesh(
    new THREE.CapsuleGeometry(0.5, 1, 4, 8),
    new THREE.MeshStandardMaterial({ color: 0x00ccff })
);
player.add(body);

const helmet = new THREE.Mesh(
    new THREE.SphereGeometry(0.38, 24, 24),
    new THREE.MeshStandardMaterial({
        color: 0xffffff,
        metalness: 0.5,
        roughness: 0.2
    })
);
helmet.position.y = 0.9;
player.add(helmet);

player.position.y = 0;
scene.add(player);

// PLANET
const planet = new THREE.Mesh(
    new THREE.SphereGeometry(4, 32, 32),
    new THREE.MeshStandardMaterial({
        color: 0x4422aa,
        roughness: 0.8
    })
);
planet.position.set(12, 5, -25);
scene.add(planet);

// ENEMY
const enemies = [];

function createEnemy() {
    const enemy = new THREE.Mesh(
        new THREE.SphereGeometry(0.7, 16, 16),
        new THREE.MeshStandardMaterial({
            color: 0xff2244,
            emissive: 0x550011
        })
    );

    enemy.position.set(
        (Math.random() - 0.5) * 25,
        1,
        -15 - Math.random() * 25
    );

    scene.add(enemy);
    enemies.push(enemy);
}

for (let i = 0; i < 6; i++) {
    createEnemy();
}

// GAME STATE
let score = 0;
let health = 100;
let gameStarted = false;
let jumping = false;
let jumpVelocity = 0;

const keys = {};

window.addEventListener('keydown', (event) => {
    keys[event.key.toLowerCase()] = true;

    if (event.code === 'Space') {
        event.preventDefault();

        if (!jumping && gameStarted) {
            jumping = true;
            jumpVelocity = 0.22;
        }
    }
});

window.addEventListener('keyup', (event) => {
    keys[event.key.toLowerCase()] = false;
});

// SHOOTING
const bullets = [];

window.addEventListener('click', () => {
    if (!gameStarted) return;

    const bullet = new THREE.Mesh(
        new THREE.SphereGeometry(0.12, 8, 8),
        new THREE.MeshBasicMaterial({ color: 0x00ffff })
    );

    bullet.position.copy(player.position);
    bullet.position.y += 0.5;

    bullet.userData.direction = new THREE.Vector3(0, 0, -1);

    scene.add(bullet);
    bullets.push(bullet);
});

// START BUTTON
document.getElementById('start-btn').addEventListener('click', () => {
    gameStarted = true;
    document.getElementById('message').style.display = 'none';
});

// GAME LOOP
function animate() {
    requestAnimationFrame(animate);

    if (gameStarted) {
        const speed = 0.12;

        if (keys['w']) player.position.z -= speed;
        if (keys['s']) player.position.z += speed;
        if (keys['a']) player.position.x -= speed;
        if (keys['d']) player.position.x += speed;

        if (jumping) {
            player.position.y += jumpVelocity;
            jumpVelocity -= 0.01;

            if (player.position.y <= 0) {
                player.position.y = 0;
                jumping = false;
            }
        }

        // Camera follows player
        camera.position.x += (player.position.x - camera.position.x) * 0.05;
        camera.position.z += (player.position.z + 12 - camera.position.z) * 0.05;
        camera.lookAt(player.position);

        // Move bullets
        for (let i = bullets.length - 1; i >= 0; i--) {
            const bullet = bullets[i];
            bullet.position.z -= 0.7;

            for (let j = enemies.length - 1; j >= 0; j--) {
                if (bullet.position.distanceTo(enemies[j].position) < 1) {
                    scene.remove(bullet);
                    scene.remove(enemies[j]);

                    bullets.splice(i, 1);
                    enemies.splice(j, 1);

                    score += 10;
                    document.getElementById('score').textContent = score;

                    createEnemy();
                    break;
                }
            }

            if (bullets[i] && bullet.position.z < -100) {
                scene.remove(bullet);
                bullets.splice(i, 1);
            }
        }
    }

    planet.rotation.y += 0.002;
    stars.rotation.y += 0.0001;

    renderer.render(scene, camera);
}

animate();

// RESIZE
window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
});
