// GRAVITY
function applyBlackHoleGravity(delta) {

    const target = new THREE.Vector3(
        blackHole.position.x,
        0,
        blackHole.position.z
    );

    const direction = target.clone().sub(player.position);

    const distance = direction.length();

    const distanceUI =
        document.getElementById('distance');

    if (distance < 8) {
        distanceUI.textContent = 'DANGER!';
        distanceUI.style.color = 'red';
    }

    else if (distance < 19) {
        distanceUI.textContent = 'WARNING';
        distanceUI.style.color = 'orange';
    }

    else {
        distanceUI.textContent = 'SAFE';
        distanceUI.style.color = '#65e6ff';
    }

    if (distance < 19 && distance > 2.5) {

        direction.normalize();

        const force = (19 - distance) * 0.65;

        player.position.addScaledVector(
            direction,
            force * delta
        );

        if (!gravityPulse) {
            messageUI.textContent =
                'WARNING! BLACK HOLE GRAVITY DETECTED!';
        }
    }

    if (distance <= 2.5 && !shield) {
        health = Math.max(0, health - 25 * delta);
    }
}

